{
  "name": "sandaga-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:offline": "EXPO_OFFLINE=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --offline --clear",
    "start:lan": "EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --lan --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:search-utils": "tsc -p tsconfig.test.json && node --test .test-dist/src/features/search/*.test.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.6",
    "@tanstack/react-query": "^5.66.8",
    "expo": "~54.0.0",
    "expo-constants": "^18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-image-picker": "~17.0.8",
    "expo-linking": "^8.0.11",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.65.0",
    "react-native": "0.81.5",
    "react-native-sse": "^1.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.16.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  }
}
